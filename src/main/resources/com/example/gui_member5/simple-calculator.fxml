<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="30" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.example.gui_member5.SimpleCalculatorController">
    <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>

    <HBox alignment="CENTER" spacing="20">
        <VBox alignment="CENTER" spacing="10">
            <Label style="-fx-font-weight: bold" text="1st Number" />
            <TextField fx:id="tfNumber1" alignment="CENTER" prefWidth="20" />
        </VBox>

        <VBox alignment="BOTTOM_CENTER" spacing="10">
            <ComboBox fx:id="cbOperations" prefWidth="60" />
        </VBox>

        <VBox alignment="CENTER" spacing="10">
            <Label style="-fx-font-weight: bold" text="2nd Number" />
            <TextField fx:id="tfNumber2" alignment="CENTER" prefWidth="20" />
        </VBox>

        <VBox alignment="CENTER" spacing="10">
            <Label style="-fx-font-weight: bold" text="Result" />
            <Label fx:id="lblResult" prefWidth="80" alignment="CENTER"
                   style="-fx-border-color: lightgrey;
                          -fx-border-width: 1;
                          -fx-border-radius: 3;
                          -fx-border-style: solid;
                          -fx-padding: 3;" />
        </VBox>
    </HBox>

    <VBox alignment="CENTER">
        <Button fx:id="btnCompute" onAction="#onComputeClick" style="-fx-font-weight: bold" text="Compute Result" />
    </VBox>
</VBox>
