<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http.javafx.com/fxml"
      fx:controller="com.example.gui_member5.NumberCounterController">

    <Label fx:id="countLabel" text="0" style="-fx-font-size: 24px;" />

    <HBox alignment="CENTER" spacing="10.0">
        <Button fx:id="decreaseButton" text="Decrease" onAction="#onDecreaseClick" />
        <Button fx:id="increaseButton" text="Increase" onAction="#onIncreaseClick" />
    </HBox>
</VBox>
